---
const { name, size = 22 } = Astro.props;

const icons = {
  shield: '<path d="M12 3.5 19 6v5.4c0 4.5-2.9 7.2-7 9.1-4.1-1.9-7-4.6-7-9.1V6l7-2.5Z"/><path d="m8.5 12 2.2 2.2 4.8-4.8"/>',
  spark: '<path d="m12 3 1.4 5.6L19 10l-5.6 1.4L12 17l-1.4-5.6L5 10l5.6-1.4L12 3Z"/><path d="m19 16 .6 2.4L22 19l-2.4.6L19 22l-.6-2.4L16 19l2.4-.6L19 16Z"/>',
  layers: '<path d="m12 3 8.5 4.5L12 12 3.5 7.5 12 3Z"/><path d="m3.5 12 8.5 4.5 8.5-4.5"/><path d="m3.5 16.5 8.5 4.5 8.5-4.5"/>',
  plug: '<path d="M9 7V3m6 4V3M7 7h10v3a5 5 0 0 1-10 0V7Z"/><path d="M12 15v6"/>',
  activity: '<path d="M3 12h4l2.2-6 4.1 12 2.2-6H21"/>',
  terminal: '<path d="m5 7 5 5-5 5"/><path d="M12 17h6"/>',
  arrow: '<path d="M5 12h13"/><path d="m13 6 6 6-6 6"/>',
  book: '<path d="M5 4.5A2.5 2.5 0 0 1 7.5 2H20v17H7.5A2.5 2.5 0 0 0 5 21.5v-17Z"/><path d="M5 18.5A2.5 2.5 0 0 1 7.5 16H20"/>',
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 20h16"/>',
  github: '<path d="M9 19c-4 .9-4-2-5-2m10 4v-3.5c0-1 .1-1.4-.5-2 1.8-.2 3.7-.9 3.7-4A3.1 3.1 0 0 0 16.4 9c.1-.3.5-1.5-.1-3 0 0-1-.3-3.3 1.2a11.4 11.4 0 0 0-6 0C4.7 5.7 3.7 6 3.7 6c-.6 1.5-.2 2.7-.1 3a3.1 3.1 0 0 0-.8 2.5c0 3.1 1.9 3.8 3.7 4-.6.6-.6 1.1-.5 2V21"/>',
  sun: '<circle cx="12" cy="12" r="3.5"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  moon: '<path d="M20.5 15.2A8.5 8.5 0 0 1 8.8 3.5 8.5 8.5 0 1 0 20.5 15.2Z"/>',
};

type IconName = keyof typeof icons;
interface Props {
  name: IconName;
  size?: number;
}

const path = icons[name] ?? icons.spark;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path}></svg>
