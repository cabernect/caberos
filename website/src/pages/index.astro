---
import MarketingLayout from "../layouts/MarketingLayout.astro";
import Icon from "../components/Icon.astro";
import { releaseTag, releaseUrl } from "../release";
import mark from "../assets/logo-mark.svg";

const { locale = "en" } = Astro.props;
const isVietnamese = locale === "vi";
const localizedPath = (path: string) => `${isVietnamese ? "/vi" : ""}${path}`;
const repositoryUrl = "https://github.com/cabernect/caberos";

const promises = isVietnamese
  ? [
      ["01", "Bạn duyệt những gì quan trọng", "Khi agent muốn làm điều có hệ quả, nó hỏi trước. Bạn phê duyệt, từ chối, hoặc ghi nhớ câu trả lời."],
      ["02", "Dữ liệu ở lại với bạn", "Bộ nhớ, file và lịch sử nằm trên máy của bạn — không phải trên server của ai khác."],
      ["03", "Bạn luôn xem lại được", "Mỗi run để lại một trace mở ra được: nó đã làm gì, dùng gì, tốn bao nhiêu."],
    ]
  : [
      ["01", "You approve what matters", "When an agent wants to do something that counts, it asks first. You approve, deny, or remember your answer."],
      ["02", "Your data stays with you", "Memory, files, and history live on your computer — not on someone else's server."],
      ["03", "You can always look back", "Every run leaves a trace you can open: what it did, what it used, and what it cost."],
    ];

const examples = isVietnamese
  ? [
      { title: "Nghiên cứu theo yêu cầu", description: "Yêu cầu đào sâu một chủ đề. Agent tìm trên web, đọc nguồn và đưa bạn bản tóm tắt kèm trích dẫn để kiểm tra.", chips: ["web search", "web fetch", "citations"] },
      { title: "Sự nghiệp và tài liệu", description: "Rà soát CV, chỉnh cho hợp một vị trí, hoặc biến ghi chú rời rạc thành tài liệu sạch sẽ.", chips: ["read files", "doc_search", "artifacts"] },
      { title: "Theo dõi thị trường", description: "Bám sát cổ phiếu hoặc tin tức Việt Nam theo lịch, với báo cáo gửi tới kênh chat của bạn.", chips: ["web search", "schedule", "telegram"] },
      { title: "Bản tin hằng ngày", description: "Tóm tắt inbox, lịch hoặc tài liệu vào buổi sáng — gửi đúng giờ bạn chọn.", chips: ["schedule", "knowledge vault", "notifications"] },
    ]
  : [
      { title: "Research on call", description: "Ask for a deep dive on any topic. The agent searches the web, reads sources, and hands you a summary with citations to check.", chips: ["web search", "web fetch", "citations"] },
      { title: "Career and documents", description: "Review a CV, tailor it for a role, or turn rough notes into a clean document.", chips: ["read files", "doc_search", "artifacts"] },
      { title: "Market watching", description: "Track stocks or Vietnamese news on a schedule, with reports delivered to your chat channel.", chips: ["web search", "schedule", "telegram"] },
      { title: "A daily brief", description: "A morning summary of your inbox, calendar, or documents — delivered at the time you choose.", chips: ["schedule", "knowledge vault", "notifications"] },
    ];

const steps = isVietnamese
  ? [
      ["Cài ứng dụng", "Tải CaberOS cho macOS hoặc Windows. Không cần Python, không cần terminal — lần chạy đầu tiên có hướng dẫn từng bước."],
      ["Kết nối một AI", "Dùng dịch vụ cloud với key của riêng bạn, hoặc chạy model ngay trên máy. CaberOS kiểm tra những gì đã sẵn sàng."],
      ["Tạo một agent", "Chọn những gì nó được phép làm, những gì cần bạn duyệt, và nơi nó làm việc. Rồi giao việc cho nó."],
    ]
  : [
      ["Install the app", "Download CaberOS for macOS or Windows. No Python, no terminal — first launch walks you through setup."],
      ["Connect an AI", "Use a cloud service with your own key, or run a model on your machine. CaberOS checks what is ready."],
      ["Create an agent", "Choose what it may do, what needs your approval, and where it works. Then give it a job."],
    ];

const features = isVietnamese
  ? [
      { icon: "inbox", kicker: "Hôm nay", title: "Bắt đầu từ chỗ cần bạn", description: "Approval đang chờ, run thất bại, thông báo chưa đọc — dải Needs You đưa tất cả lên trước mắt bạn." },
      { icon: "activity", kicker: "Trace", title: "Xem run như một timeline", description: "Mở bất kỳ run nào thành cây span và waterfall: tool call, approval, thinking, token và chi phí theo đúng thứ tự." },
      { icon: "book", kicker: "Knowledge Vault", title: "Tài liệu agent có thể trích dẫn", description: "Tải file vào scope dùng chung hoặc riêng của agent. Retrieval local mặc định; hybrid embedding chỉ khi bạn bật." },
      { icon: "spark", kicker: "Skill tiến hóa", title: "Playbook tự cải thiện", description: "Sau khi session đóng, một reflection có giới hạn có thể đề xuất chỉnh sửa skill của agent — mọi revision đều xem lại được." },
      { icon: "globe", kicker: "Browser", title: "Trình duyệt cho agent", description: "Trình duyệt được quản lý có thể mở trang, click và trích xuất — trong phạm vi domain và cổng approval của bạn." },
      { icon: "clock", kicker: "Scheduler", title: "Run sống qua restart", description: "Chạy một lần, theo interval hoặc cron với timezone thật. Run lỡ được phục hồi khi khởi động; overlap và retry là chính sách rõ ràng." },
    ] as const
  : [
      { icon: "inbox", kicker: "Today", title: "Start where you're needed", description: "Waiting approvals, failed runs, unread notices — the Needs You strip puts them in front of you first." },
      { icon: "activity", kicker: "Traces", title: "Watch a run like a timeline", description: "Open any run as a span tree and waterfall: tool calls, approvals, thinking, tokens, and cost in order." },
      { icon: "book", kicker: "Knowledge Vault", title: "Documents agents can cite", description: "Upload files into shared or agent-private scopes. Local full-text retrieval by default; hybrid embeddings only if you opt in." },
      { icon: "spark", kicker: "Evolving skills", title: "Playbooks that improve themselves", description: "After a session closes, a bounded reflection can propose staged edits to the agent's own skills — every revision inspectable." },
      { icon: "globe", kicker: "Browser", title: "A browser agents can use", description: "A managed browser opens pages, clicks, and extracts — inside domain leashes and your approval gates." },
      { icon: "clock", kicker: "Scheduler", title: "Runs that survive restarts", description: "Once, interval, or cron with real time zones. Missed runs recover on startup; overlap and retry are explicit policies." },
    ] as const;

const comparison = isVietnamese
  ? {
      headers: ["", "CaberOS", "Trợ lý AI thông thường", "Script tự viết"],
      rows: [
        ["File và bộ nhớ ở đâu", "Trên máy của bạn", "Trên server của provider", "Tùy bạn để đâu"],
        ["Ai duyệt hành động", "Bạn, từng hành động một", "Tùy sản phẩm", "Bạn phải tự xây"],
        ["Ghi lại những gì đã xảy ra", "Có sẵn", "Tùy sản phẩm", "Bạn phải tự xây"],
        ["Chọn model AI", "Cloud hoặc local", "Thường một provider", "Bất kỳ"],
        ["Cài đặt", "Cài app là xong", "Đăng ký tài khoản", "Viết code"],
      ],
    }
  : {
      headers: ["", "CaberOS", "Typical AI assistants", "Do-it-yourself scripts"],
      rows: [
        ["Where files and memory live", "On your computer", "On the provider's servers", "Wherever you put them"],
        ["Who approves actions", "You, action by action", "Varies by product", "You have to build it"],
        ["Record of what happened", "Built in", "Varies by product", "You have to build it"],
        ["Choice of AI model", "Cloud or local", "Usually one provider", "Any"],
        ["Setup", "Install the app", "Sign up", "Write code"],
      ],
    };

const faqs = isVietnamese
  ? [
      ["Tôi có cần biết lập trình không?", "Không. CaberOS chạy như một app desktop với hướng dẫn cài đặt từng bước; bạn mô tả agent bằng ngôn ngữ thường."],
      ["Dữ liệu của tôi có rời khỏi máy không?", "File, bộ nhớ và lịch sử ở lại trên máy. Prompt chỉ đi tới AI provider bạn tự kết nối — ranh giới được hiển thị rõ, không giấu."],
      ["Chạy trên máy nào?", "App desktop phát hành cho macOS Apple Silicon và Windows x64. Docker và cài từ source hỗ trợ macOS, Linux và Windows (WSL2)."],
      ["Tôi có tin được việc agent làm không?", "Bạn không cần tin — bạn kiểm tra. Approval chặn các hành động quan trọng và mọi run đều có trace mở ra xem được."],
    ]
  : [
      ["Do I need to know how to code?", "No. CaberOS runs as a desktop app with guided setup; you describe agents in plain words."],
      ["Does my data leave my computer?", "Files, memory, and history stay on your machine. Prompts go only to the AI provider you connect — the boundary is shown, not hidden."],
      ["Which computers does it run on?", "The desktop app ships for macOS Apple Silicon and Windows x64. Docker and source installs cover macOS, Linux, and Windows (WSL2)."],
      ["Can I trust what an agent does?", "You don't have to trust it — check it. Approvals gate consequential actions and every run keeps an inspectable trace."],
    ];
---

<MarketingLayout
  locale={locale}
  title={isVietnamese ? "CaberOS — Agent của bạn. Máy của bạn. Luật của bạn." : "CaberOS — Your agents. Your machine. Your rules."}
  description={isVietnamese ? "CaberOS là hệ điều hành mã nguồn mở, local-first cho agent AI cá nhân, với bộ nhớ, công cụ, quyền hạn và khả năng quan sát." : "CaberOS is an open-source, local-first operating system for personal AI agents with memory, tools, permissions, and observability."}
>
  <div class="announcement container" data-reveal>
    <span class="announcement-mark" aria-hidden="true"></span>
    <span>{isVietnamese ? `${releaseTag} đã có cho macOS và Windows` : `${releaseTag} is available for macOS and Windows`}</span>
    <a href={releaseUrl}>{isVietnamese ? "Xem bản phát hành" : "View release"} <Icon name="arrow" size={15} /></a>
  </div>

  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span>{isVietnamese ? "Mã nguồn mở · local-first" : "Open source · local-first"}</p>
        <h1 id="hero-title">{isVietnamese ? "Agent của bạn." : "Your agents."} <span>{isVietnamese ? "Máy của bạn." : "Your machine."}</span> {isVietnamese ? "Luật của bạn." : "Your rules."}</h1>
        <p class="hero-lead">
          {isVietnamese ? "CaberOS chạy agent AI cá nhân trên chính máy của bạn. Chúng nghiên cứu, viết và canh chừng thay bạn — và không việc gì quan trọng xảy ra mà thiếu sự cho phép của bạn." : "CaberOS runs personal AI agents on your own computer. They research, write, and keep watch for you — and nothing important happens without your approval."}
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href={localizedPath("/download/")}>
            {isVietnamese ? "Tải CaberOS" : "Download CaberOS"}
            <Icon name="download" size={17} />
          </a>
          <a class="button button-secondary" href={localizedPath("/docs/")}>
            {isVietnamese ? "Xem cách hoạt động" : "See how it works"}
            <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="hero-facts" aria-label={isVietnamese ? "Thông tin sản phẩm" : "Product facts"}>
          <span><i class="fact-dot"></i>{isVietnamese ? "Miễn phí, mã nguồn mở" : "Free, open source"}</span>
          <span><i class="fact-dot"></i>{isVietnamese ? "Không cần biết code" : "No coding needed"}</span>
          <span><i class="fact-dot"></i>{isVietnamese ? "Chi phí dừng trên máy bạn" : "Costs stay on your machine"}</span>
        </div>
      </div>

      <div class="hero-map" aria-label={isVietnamese ? "Sơ đồ agent CaberOS kết nối công cụ và dữ liệu" : "CaberOS agent map connecting tools and data"}>
        <svg class="map-wires" viewBox="0 0 560 400" fill="none" aria-hidden="true">
          <path class="edge" pathLength="100" style="--d:0" d="M206 200 C 186 200 162 200 144 200" />
          <path class="edge" pathLength="100" style="--d:1" d="M352 178 C 392 154 440 110 476 90" />
          <path class="edge" pathLength="100" style="--d:2" d="M354 200 C 380 200 404 200 428 200" />
          <path class="edge" pathLength="100" style="--d:3" d="M352 222 C 394 252 444 290 476 310" />
          <path class="edge" pathLength="100" style="--d:4" d="M208 222 C 166 252 116 290 84 310" />
          <rect class="gate" x="413.2" y="265.2" width="8.6" height="8.6" transform="rotate(45 417.5 269.5)" />
          <g class="edge-dots">
            <circle cx="144" cy="200" r="3" />
            <circle cx="476" cy="90" r="3" />
            <circle cx="428" cy="200" r="3" />
            <circle cx="476" cy="310" r="3" />
            <circle cx="84" cy="310" r="3" />
          </g>
          <circle class="flow-dot" r="3.1">
            <animateMotion dur="7s" repeatCount="indefinite" path="M206 200 C 186 200 162 200 144 200" />
          </circle>
          <circle class="flow-dot" r="3.1">
            <animateMotion dur="6.2s" begin="-2s" repeatCount="indefinite" path="M352 178 C 392 154 440 110 476 90" />
          </circle>
          <circle class="flow-dot" r="3.1">
            <animateMotion dur="5.4s" begin="-3.6s" repeatCount="indefinite" path="M354 200 C 380 200 404 200 428 200" />
          </circle>
          <circle class="flow-dot" r="3.1">
            <animateMotion dur="7.8s" begin="-1.4s" repeatCount="indefinite" path="M352 222 C 394 252 444 290 476 310" />
          </circle>
          <circle class="flow-dot" r="3.1">
            <animateMotion dur="8.6s" begin="-4.8s" repeatCount="indefinite" path="M208 222 C 166 252 116 290 84 310" />
          </circle>
          <circle class="flow-dot in" r="2.4">
            <animateMotion dur="9.5s" begin="-6s" repeatCount="indefinite" path="M144 200 C 162 200 186 200 206 200" />
          </circle>
          <circle class="flow-dot in" r="2.4">
            <animateMotion dur="11s" begin="-2.8s" repeatCount="indefinite" path="M476 90 C 440 110 392 154 352 178" />
          </circle>
        </svg>

        <span class="map-chip" style="--x:33%;--y:39.5%">{isVietnamese ? "ở lại máy" : "stays local"}</span>
        <span class="map-chip" style="--x:73%;--y:29.5%">{isVietnamese ? "key của bạn" : "your key"}</span>
        <span class="map-chip" style="--x:70%;--y:44%">grants</span>
        <span class="map-chip" style="--x:73.5%;--y:66.5%">approvals</span>
        <span class="map-chip" style="--x:26.5%;--y:66.5%">{isVietnamese ? "xem lại được" : "inspectable"}</span>

        <div class="map-node" style="--x:14.3%;--y:50%;--i:0">
          <span class="node-icon"><Icon name="layers" size={15} /></span>
          <span class="node-text"><b>{isVietnamese ? "bộ nhớ" : "memory"}</b><i>{isVietnamese ? "& file" : "& files"}</i></span>
        </div>
        <div class="map-node" style="--x:85.7%;--y:15.7%;--i:1">
          <span class="node-icon"><Icon name="spark" size={15} /></span>
          <span class="node-text"><b>AI provider</b><i>{isVietnamese ? "bạn chọn" : "you choose"}</i></span>
        </div>
        <div class="map-node" style="--x:87.5%;--y:50%;--i:2">
          <span class="node-icon"><Icon name="plug" size={15} /></span>
          <span class="node-text"><b>MCP tools</b><i>{isVietnamese ? "của bạn" : "yours"}</i></span>
        </div>
        <div class="map-node" style="--x:85.7%;--y:84.3%;--i:3">
          <span class="node-icon"><Icon name="chat" size={15} /></span>
          <span class="node-text"><b>{isVietnamese ? "kênh chat" : "chat apps"}</b><i>{isVietnamese ? "bạn bật" : "you enable"}</i></span>
        </div>
        <div class="map-node" style="--x:14.3%;--y:84.3%;--i:4">
          <span class="node-icon"><Icon name="book" size={15} /></span>
          <span class="node-text"><b>skills</b><i>{isVietnamese ? "tự tiến hóa" : "self-improving"}</i></span>
        </div>

        <span class="center-ping" aria-hidden="true"></span>
        <div class="map-center" style="--x:50%;--y:50%">
          <span class="center-icon"><img src={mark.src} alt="" width="19" height="19" /></span>
          <b>CaberOS</b>
          <i>{isVietnamese ? "agent sống ở đây" : "agents live here"}</i>
        </div>
      </div>
    </div>
  </section>

  <section class="section watch-section" aria-labelledby="watch-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow"><span class="eyebrow-line"></span>{isVietnamese ? "Xem thực tế" : "See it live"}</p>
        <h2 id="watch-title">{isVietnamese ? "Một run thật, 48 giây." : "One real run, 48 seconds."}</h2>
        <p>{isVietnamese ? "Một agent, một lần phê duyệt, một kết quả — quay từ app thật, không dựng mockup." : "One agent, one approval, one deliverable — recorded from the real app, not a mockup."}</p>
      </div>
      <div class="watch-card" data-reveal>
        <video
          src="/videos/caberos-promises.mp4"
          poster="/videos/caberos-promises-poster.jpg"
          preload="none"
          controls
          playsinline
        ></video>
        <button class="watch-play" type="button" aria-label={isVietnamese ? "Phát video CaberOS" : "Play the CaberOS film"}>
          <svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" fill="currentColor"/></svg>
        </button>
      </div>
    </div>
  </section>

  <section class="promises-section" aria-label={isVietnamese ? "Ba cam kết của CaberOS" : "CaberOS promises"}>
    <div class="container">
      <p class="eyebrow"><span class="eyebrow-line"></span>{isVietnamese ? "Vì sao CaberOS" : "Why CaberOS"}</p>
      <h2 class="section-title">{isVietnamese ? "Ba cam kết, nói thẳng." : "Three promises, in plain words."}</h2>
      <div class="promise-grid">
        {promises.map(([number, title, description], i) => (
          <article class="promise" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <span class="promise-number mono">{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section examples-section" id="use-cases" aria-labelledby="examples-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow"><span class="eyebrow-line"></span>{isVietnamese ? "Thử ngay" : "Try these"}</p>
        <h2 id="examples-title">{isVietnamese ? "Vài agent bạn có thể dựng." : "Agents you can set up."}</h2>
        <p>{isVietnamese ? "Mỗi agent chỉ nhận đúng tool và quyền bạn cấp. Cấu hình mẫu bên dưới." : "Each agent only gets the tools and permissions you grant. Sample setups below."}</p>
      </div>
      <div class="example-list">
        {examples.map((example, i) => (
          <article class="example-row" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <div class="example-main">
              <h3>{example.title}</h3>
              <p>{example.description}</p>
            </div>
            <div class="example-chips">
              {example.chips.map((chip) => <span class="chip mono">{chip}</span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section steps-section" id="how-it-works" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-intro" data-reveal>
        <p class="eyebrow"><span class="eyebrow-line"></span>{isVietnamese ? "Cách hoạt động" : "How it works"}</p>
        <h2 id="steps-title">{isVietnamese ? "Chạy được trong ba bước." : "Up and running in three steps."}</h2>
      </div>
      <div class="step-grid">
        {steps.map(([title, description], i) => (
          <article class="step" data-reveal style={`--reveal-delay: ${i * 100}ms`}>
            <span class="step-number">{i + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section features-section" id="product" aria-labelledby="features-title">
    <div class="container">
      <div class="section-heading-row" data-reveal>
        <div>
          <p class="eyebrow"><span class="eyebrow-line"></span>{isVietnamese ? `Có gì trong ${releaseTag}` : `What's inside ${releaseTag}`}</p>
          <h2 id="features-title">{isVietnamese ? "Những lớp xung quanh prompt mới là phần quan trọng." : "The pieces around the prompt are the product."}</h2>
        </div>
        <p class="section-side-copy">{isVietnamese ? "Bắt đầu với một agent. Thêm context và capability theo nhu cầu công việc — không cần mở toàn bộ hệ thống cùng lúc." : "Start with one agent. Add context and capability as your work demands it — without giving the whole system away at once."}</p>
      </div>
      <div class="feature-grid">
        {features.map((feature, i) => (
          <article class="feature-card" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
            <div class="feature-icon"><Icon name={feature.icon} size={22} /></div>
            <span class="card-kicker mono">{feature.kicker}</span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section security-section" id="security" aria-labelledby="security-title">
    <div class="container">
      <div class="security-card" data-reveal>
        <div class="security-heading">
          <div class="feature-icon dark-icon"><Icon name="shield" size={24} /></div>
