<script>
  // Scroll-triggered reveal using IntersectionObserver — adds data-revealed
  // when an element enters the viewport. Stagger is via --reveal-delay.
  const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]");
  if (revealEls.length > 0) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).dataset.revealed = "";
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
    );
    revealEls.forEach((el) => io.observe(el));
  }

  // Watch card — poster + play overlay; video loads on first play (preload="none").
  const watchCard = document.querySelector<HTMLElement>(".watch-card");
  const watchVideo = watchCard?.querySelector("video");
  watchCard?.querySelector<HTMLButtonElement>(".watch-play")?.addEventListener("click", () => {
    watchVideo?.play();
    watchCard.setAttribute("data-playing", "");
  });
</script>

