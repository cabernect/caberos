# CaberOS Docker environment variables
# Copy to .env.docker and edit, then: docker compose --env-file .env.docker up

# Port exposed on the host for the web UI
CABEROS_PORT=8080

# YOLO mode — skip all approval gates (tools execute without confirmation)
# Useful for headless/Docker deployments. Set to "true" to enable.
AGENTOS_YOLO_MODE=false
